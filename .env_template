# --------------------------------------------------
# Logging
# --------------------------------------------------
# LOG_LEVEL=INFO

# --------------------------------------------------
# Registry configuration
# --------------------------------------------------
# DEFAULT_REGISTRY=
# REGISTRY_USER=
# REGISTRY_PW=
# Write the registry credentials into the generated deploy script.
# INCLUDE_CREDENTIALS=false

# --------------------------------------------------
# Platform / build selection
# --------------------------------------------------
# PLATFORM_FILTER=kaapana-admin-chart
# EXTERNAL_SOURCE_DIRS=
# BUILD_IGNORE_PATTERNS=*templates_and_examples/*,*ci/*,*lib/task_api/*

# CONTAINERS_TO_BUILD_BY_CHARTS=
# CONTAINERS_TO_BUILD=

# ONLY_CHARTS=false
# INTERACTIVE=false

# --------------------------------------------------
# Build behavior
# --------------------------------------------------
# BUILD_ONLY=false
# PARALLEL_PROCESSES=2
# NO_LOGIN=false

# --------------------------------------------------
# Linting & validation
# --------------------------------------------------
# ENABLE_LINTING=true
# EXIT_ON_ERROR=true
# CONFIGURATION_CHECK=false
# CONFIGURATION_CHECK_SEVERITY_LEVEL=CRITICAL,HIGH

# --------------------------------------------------
# Vulnerability scanning
# --------------------------------------------------
# VULNERABILITY_SCAN=false
# VULNERABILITY_SEVERITY_LEVEL=CRITICAL,HIGH
# CHECK_EXPIRED_VULNERABILITY_DB=false

# --------------------------------------------------
# SBOMs & statistics
# --------------------------------------------------
# CREATE_SBOMS=false
# ENABLE_IMAGE_STATS=false

# --------------------------------------------------
# Image handling
# --------------------------------------------------
# USE_LATEST_TAG=false
# PUSH_TO_MICROK8S=false
# CREATE_OFFLINE_INSTALLATION=false
# INCLUDE_MODEL_WEIGHTS=false

# --------------------------------------------------
# Offline installer (extend CREATE_OFFLINE_INSTALLATION above)
# --------------------------------------------------
# Also publish the offline installer as <registry>/offline-installer:<version> (requires registry login).
# PUBLISH_OFFLINE_INSTALLER=false
# Skip the (large) platform-images tarball; use when targets pull images from the registry instead of a true air-gap import.
# SKIP_PLATFORM_IMAGES_TARBALL=false
# Container image platform for offline installer tarballs, e.g. linux/amd64 or linux/arm64. Defaults to the build host platform.
# OFFLINE_IMAGE_PLATFORM=
# Extra files/dirs to include in the offline installer tar as comma-separated SRC[:DST] (DST is relative to the installer root).
# OFFLINE_EXTRA_FILES=

# --------------------------------------------------
# Layer caching
# --------------------------------------------------
# Embed inline cache metadata in every built image so future builds can use it as a cache source.
# ENABLE_INLINE_CACHE=true
#
# Pull <registry>/<image>:<CACHE_FROM_TAG> before each build and use it as --cache-from.
# For local-only base images the build system automatically finds non-local dependents to pull.
# CACHE_FROM_TAG=latest

# --------------------------------------------------
# Paths
# Only needed if you are buiding your own platform
# or have a specific build directory
# --------------------------------------------------
# KAAPANA_DIR=/path/to/kaapana
# BUILD_DIR=/path/to/kaapana/build

# --------------------------------------------------
# Networking
# --------------------------------------------------
# http_proxy=
# PLAIN_HTTP=false

# --------------------------------------------------
# Tooling
# --------------------------------------------------
# HELM_EXECUTABLE=helm
# CONTAINER_ENGINE=docker
