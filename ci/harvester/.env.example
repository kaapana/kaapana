# Template for .env — copy this file to .env and fill in the values.
# Gitignored; read directly by inventory.yaml and ci_fleet.py, so no
# exporting and no sourcing is needed.
# A real environment variable of the same name overrides the value here.

# Token scopes: api, read_repository, write_repository, create_runner, manage_runner
GITLAB_API_TOKEN="<api-token>"
GITLAB_PROJECT_ID="2521"
GITLAB_URL="https://codebase.helmholtz.cloud/"

HARVESTER_NAMESPACE="kaapana-ci"
VM_DNS_DOMAIN="vms.dkfz.de"
VM_USER="ubuntu"

SSH_PRIVATE_KEY="~/.ssh/kaapana.pem"
HARVESTER_KUBECONFIG="~/.kube/harvester.yaml"

# Optional: register the runners paused so a new VM can be inspected
# before it takes jobs.
# RUNNERS_PAUSED=true
