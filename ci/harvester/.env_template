# Copy this file to .env and fill in your values
# .env is in .gitignore and won't be tracked in git

# ==================================================================================
# GitLab Configuration
# ==================================================================================
# Get a new Personal Access Token from:
# https://codebase.helmholtz.cloud/-/user_settings/personal_access_tokens
# Scopes needed: api, read_repository, write_repository, create_runner, manage_runner
GITLAB_API_TOKEN="your-gitlab-pat-token-here"

# ==================================================================================
# Harvester/Kubernetes Configuration
# ==================================================================================
# Path to your Harvester kubeconfig file
# Ask your Harvester administrator if you don't have this
# Can be downloaded in the harvester web interface under "User Profile" -> "Kubeconfig"
HARVESTER_KUBECONFIG="/path/to/harvester.yaml"

# ==================================================================================
# SSH Keys for VM Access
# ==================================================================================
# Path to SSH public key (for VM creation)
SSH_PUBLIC_KEY="/path/to/your/public.pem"

# Path to SSH private key (for VM access)
SSH_PRIVATE_KEY="/path/to/your/private.pem"

# CI Variables (set UPLOAD_CI_VARIABLES=true to upload)
UPLOAD_CI_VARIABLES="false"
DOCKER_IO_USER="your-user"
DOCKER_IO_PASSWORD="your-password"
CI_REGISTRY_URL="your-registry"
CI_REGISTRY_TOKEN="your-token"