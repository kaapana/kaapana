{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["name", "version", "contents"],
  "properties": {
    "name": { "type": "string", "pattern": "^[A-Za-z0-9-_]+$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "contents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "contentType", "files"],
        "properties": {
          "name": { "type": "string" },
          "contentType": { "type": "string" },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path"],
              "properties": { "path": { "type": "string" } }
            }
          }
        }
      }
    },
    "dependencies": { "type": "array" }
  }
}