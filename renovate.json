{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "semanticCommits": "enabled",
  "timezone": "Europe/Berlin",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "dependencyDashboardApproval": true,
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "labels": ["Dependencies"],
  "dependencyDashboard": {
    "title": "Dependency Dashboard (Renovate)",
    "labels": ["Dependencies", "Pending"],
    "osvVulnerabilitySummary": "unresolved"
  },
  "commitMessageExtra": "from {{{currentValue}}} to {{#if isPinDigest}}{{{newDigestShort}}}{{else}}{{#if isSingleVersion}}{{prettyNewVersion}}{{else}}{{#if newValue}}{{{newValue}}}{{else}}{{{newDigestShort}}}{{/if}}{{/if}}{{/if}}",
  "enabledManagers": [
    "dockerfile",
    "gitlabci",
    "pip_requirements",
    "pep621",
    "npm",
    "maven",
    "pre-commit",
    "ansible",
    "helm-requirements",
    "helm-values",
    "custom.regex"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "ignore/**",
    "build/**",
    "templates_and_examples/**",
    "docs/Pipfile",
    "utils/**",
    "services/kaapana-admin/rabbitmq/rabbitmq-3.8/**",
    "constraints/0.3.0.txt",
    "constraints/0.4.0.txt",
    "services/flow/airflow/docker/files/constraints-3.12.txt",
    "data-processing/workflows/**",
    "data-processing/processing-pipelines/**",
    "services/base/kaapana-backend/**",
    "services/kaapana-admin/kube-helm/**",
    "services/meta/**"
  ],
  "gitlabci": {
    "managerFilePatterns": ["/^ci/pipeline/[^/]+\\.ya?ml$/"]
  },
  "pip_requirements": {
    "managerFilePatterns": ["/^constraints/[^/]+\\.txt$/"]
  },
  "pre-commit": {
    "enabled": true
  },
  "ansible": {
    "managerFilePatterns": ["/^ci/ci-code/deploy/[^/]+\\.ya?ml$/"]
  },
  "hostRules": [
    {
      "matchHost": "registry.npmjs.org",
      "timeout": 180000
    }
  ],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "addLabels": ["Security"],
    "semanticCommitType": "fix",
    "commitMessageSuffix": "[SECURITY] [{{vulnerabilitySeverity}}]",
    "dependencyDashboardApproval": true,
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Dockerfile[^/]*$/",
        "/^ci/pipeline/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?(?: extractVersion=(?<extractVersion>\\S+))?\\s+(?:(?:ARG|ENV) [A-Z0-9_]+=\"?|[A-Z0-9_]+: \")(?<currentValue>[^\"\\s]+)"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^services/kaapana-admin/auth-backend/docker/Dockerfile$/",
        "/^ci/pipeline/unit-tests\\.yml$/"
      ],
      "matchStrings": [
        "openpolicyagent\\.org/downloads/v(?<currentValue>\\d+\\.\\d+\\.\\d+)/opa_"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "open-policy-agent/opa",
      "extractVersionTemplate": "^v(?<version>\\d+\\.\\d+\\.\\d+)$"
    }
  ],
  "packageRules": [
    // Ignore: turn off tracking for specific packages and files.
    {
      "matchPackageNames": [
        // Renovate cannot find the "updated" version online as those are built locally.
        "local-only/**",
        // Kaapana's own images, rebuilt by hand (e.g. the patched collabora image).
        "registry.hzdr.de/kaapana/**",
        // Internal Python packages from lib/, installed via file:// or git+; PyPI has no such package of ours.
        "kaapana-client",
        "kaapana-containers",
        "task-api"
      ],
      "enabled": false
    },
    {
      "matchManagers": ["helm-values"],
      "matchJsonata": ["$not($exists(currentValue))"],
      "enabled": false
    },
    {
      "matchDatasources": ["npm", "pypi"],
      "minimumReleaseAge": "3 days"
    },
    // Approval: major updates wait for a Dependency Dashboard checkbox.
    {
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    // Groups: move the versions in a group together in one MR. Later rules override earlier ones.
    {
      "matchManagers": ["pip_requirements", "pep621"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Python dependencies"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "other npm dependencies"
    },
    {
      "matchFileNames": ["services/**"],
      "matchManagers": ["pip_requirements", "pep621", "npm", "maven"],
      "groupName": "dependencies",
      "additionalBranchPrefix": "{{{replace '^services/[^/]+/([^/]+).*$' '$1-' packageFileDir}}}",
      "semanticCommitScope": "{{{replace '^services/[^/]+/([^/]+).*$' '$1' packageFileDir}}}"
    },
    {
      "matchFileNames": ["data-processing/base-images/**"],
      "matchManagers": ["pip_requirements", "pep621"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "base image Python dependencies"
    },
    {
      "matchManagers": ["dockerfile", "ansible", "helm-values"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "container base images"
    },
    {
      "matchFileNames": [
        "ci/**",
        ".gitlab-ci.yml",
        ".pre-commit-config.yaml",
        "package.json",
        "tests/**"
      ],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "CI tooling"
    },
    {
      "matchPackageNames": ["docker.io/library/docker"],
      "groupName": "docker engine"
    },
    {
      "matchPackageNames": ["ruff", "astral-sh/ruff-pre-commit"],
      "groupName": "ruff"
    },
    {
      "matchPackageNames": ["hadolint/hadolint", "AleksaC/hadolint-py"],
      "groupName": "hadolint"
    },
    {
      "matchPackageNames": [
        "docker.io/openpolicyagent/opa",
        "open-policy-agent/opa"
      ],
      "groupName": "opa"
    },
    {
      "matchPackageNames": ["playwright", "@playwright/test"],
      "groupName": "playwright",
      "additionalBranchPrefix": "",
      "semanticCommitScope": "deps"
    },
    // CI image: remind to bump CI_IMAGES_TAG when the ci-base image changes.
    {
      "matchFileNames": [
        "ci/images/**",
        "ci/harvester/tasks/requirements.txt",
        "ci/ci-code/integration_tests/pyproject.toml"
      ],
      "prBodyNotes": [
        "**CI image:** this MR changes the `ci-base` image. Bump `CI_IMAGES_TAG` in `.gitlab-ci.yml` on this branch before merging. Otherwise the runners keep using the old image."
      ]
    }
  ]
}
