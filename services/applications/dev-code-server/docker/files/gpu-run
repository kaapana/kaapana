#!/bin/bash
#
# gpu-run - Launch a GPU job to execute a script and stream the output
#
# Usage: gpu-run <script.py> [args...]
#        gpu-run --help
#
# This script creates a Kubernetes Job with GPU access that runs the specified
# script using the same codebase mounted in /kaapana/minio. The output is 
# streamed back to this terminal.
#
# Examples:
#   gpu-run train.py --epochs 10
#   gpu-run scripts/inference.py --model model.pth
#

set -e

# Log directory for GPU job output
GPU_LOG_DIR="/kaapana/minio/.gpu-logs"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

show_help() {
    cat << EOF
gpu-run - Launch a GPU job to execute a script

USAGE:
    gpu-run [--name <prefix>] <script> [args...]
    gpu-run --list              List running GPU jobs
    gpu-run --logs <job-name>   Show logs for a specific job
    gpu-run --delete <job-name> Delete a specific job
    gpu-run --kill [job-name]   Kill a running job (latest if no name given)
    gpu-run --clean             Delete all completed GPU jobs
    gpu-run --status            Check GPU availability and cluster status
    gpu-run --help              Show this help message

OPTIONS:
    --name <prefix>  Set a custom prefix for the job name and log file.
                     The job will be named <prefix>-<date>-<random> instead
                     of gpu-job-<random>-<timestamp>.

DESCRIPTION:
    This command creates a Kubernetes Job with GPU access that runs the 
    specified script. The job uses the same codebase as this code-server
    instance (mounted at /kaapana/minio).

    The GPU job runs in its own container with full GPU access, so you can
    run training or inference without blocking the code-server.

EXAMPLES:
    # Run a Python training script
    gpu-run train.py --epochs 10 --batch-size 32

    # Run with a custom job name prefix
    gpu-run --name my-training train.py --epochs 10

    # Run a script in a subdirectory
    gpu-run scripts/inference.py --model weights.pth

    # Check GPU status before running
    gpu-run --status

    # List all GPU jobs for this code-server
    gpu-run --list

    # View logs from a specific job
    gpu-run --logs my-training-20260205-a1b2c3

    # Kill a running job (interactive picker if multiple)
    gpu-run --kill

    # Kill a specific running job by name
    gpu-run --kill my-training-20260205-a1b2c3

    # Clean up completed jobs
    gpu-run --clean

ENVIRONMENT:
    GPU_JOB_NAMESPACE  Kubernetes namespace (set automatically)
    RELEASE_NAME       Release name of this code-server (set automatically)

EOF
}

# Check required environment variables
check_env() {
    if [ -z "$GPU_JOB_NAMESPACE" ]; then
        echo -e "${RED}Error: GPU_JOB_NAMESPACE environment variable not set${NC}"
        exit 1
    fi
    if [ -z "$RELEASE_NAME" ]; then
        echo -e "${RED}Error: RELEASE_NAME environment variable not set${NC}"
        exit 1
    fi
}

# List GPU jobs for this release
list_jobs() {
    check_env
    echo -e "${BLUE}GPU Jobs for ${RELEASE_NAME}:${NC}"
    kubectl get jobs -n "$GPU_JOB_NAMESPACE" -l "dev-code-server-release=$RELEASE_NAME" \
        -o custom-columns=NAME:.metadata.name,STATUS:.status.conditions[0].type,COMPLETED:.status.succeeded,FAILED:.status.failed,AGE:.metadata.creationTimestamp 2>/dev/null || \
        echo "No jobs found"
}

# Show logs for a job
show_logs() {
    check_env
    local job_name="$1"
    if [ -z "$job_name" ]; then
        echo -e "${RED}Error: Job name required${NC}"
        exit 1
    fi
    echo -e "${BLUE}Logs for job: ${job_name}${NC}"
    # Get the actual pod name for proper log streaming
    local pod_name=$(kubectl get pods -n "$GPU_JOB_NAMESPACE" -l "job-name=$job_name" -o jsonpath='{.items[0].metadata.name}' 2>/dev/null)
    if [ -n "$pod_name" ]; then
        kubectl logs -n "$GPU_JOB_NAMESPACE" "$pod_name" --follow 2>/dev/null || true
    else
        kubectl logs -n "$GPU_JOB_NAMESPACE" "job/$job_name" --follow 2>/dev/null || \
            kubectl logs -n "$GPU_JOB_NAMESPACE" -l "job-name=$job_name" --follow
    fi
}

# Delete a specific job
delete_job() {
    check_env
    local job_name="$1"
    if [ -z "$job_name" ]; then
        echo -e "${RED}Error: Job name required${NC}"
        exit 1
    fi
    echo -e "${YELLOW}Deleting job: ${job_name}${NC}"
    kubectl delete job -n "$GPU_JOB_NAMESPACE" "$job_name"
}

# Kill a running job (by name, or the most recent one)
kill_job() {
    check_env
    local job_name="$1"

    if [ -z "$job_name" ]; then
        # Find running jobs (pods in Running or Pending state)
        local running_jobs=$(kubectl get pods -n "$GPU_JOB_NAMESPACE" \
            -l "dev-code-server-release=$RELEASE_NAME" \
            --no-headers 2>/dev/null | grep -E "Running|Pending|ContainerCreating" || true)

        if [ -z "$running_jobs" ]; then
            echo -e "${GREEN}No running GPU jobs to kill.${NC}"
            echo ""
            echo -e "Use ${YELLOW}gpu-run --list${NC} to see all jobs (including completed)."
            exit 0
        fi

        local count=$(echo "$running_jobs" | wc -l)
        if [ "$count" -eq 1 ]; then
            # Single running job — kill it directly
            local pod=$(echo "$running_jobs" | awk '{print $1}')
            job_name=$(kubectl get pod -n "$GPU_JOB_NAMESPACE" "$pod" \
                -o jsonpath='{.metadata.labels.job-name}' 2>/dev/null)
            echo -e "${YELLOW}Killing the only running GPU job: ${job_name}${NC}"
        else
            # Multiple running jobs — list them and ask
            echo -e "${BLUE}Running GPU jobs:${NC}"
            echo ""
            local i=1
            local job_names=()
            while IFS= read -r line; do
                local pod=$(echo "$line" | awk '{print $1}')
                local status=$(echo "$line" | awk '{print $3}')
                local jn=$(kubectl get pod -n "$GPU_JOB_NAMESPACE" "$pod" \
                    -o jsonpath='{.metadata.labels.job-name}' 2>/dev/null)
                job_names+=("$jn")
                echo -e "  ${YELLOW}[$i]${NC} $jn  (${status})"
                i=$((i + 1))
            done <<< "$running_jobs"
            echo ""
            read -rp "Enter number to kill (or 'all' to kill all, 'q' to quit): " choice

            if [ "$choice" = "q" ] || [ "$choice" = "Q" ]; then
                echo "Cancelled."
                exit 0
            fi

            if [ "$choice" = "all" ]; then
                for jn in "${job_names[@]}"; do
                    echo -e "${YELLOW}Killing job: ${jn}${NC}"
                    kubectl delete job -n "$GPU_JOB_NAMESPACE" "$jn" --wait=false 2>/dev/null || true
                done
                echo -e "${GREEN}All running GPU jobs killed.${NC}"
                exit 0
            fi

            if ! [[ "$choice" =~ ^[0-9]+$ ]] || [ "$choice" -lt 1 ] || [ "$choice" -gt "${#job_names[@]}" ]; then
                echo -e "${RED}Invalid selection.${NC}"
                exit 1
            fi
            job_name="${job_names[$((choice - 1))]}"
        fi
    fi

    echo -e "${YELLOW}Killing job: ${job_name}${NC}"
    kubectl delete job -n "$GPU_JOB_NAMESPACE" "$job_name" --wait=false 2>/dev/null

    # Update the log file if it exists
    local log_file="${GPU_LOG_DIR}/${job_name}.log"
    if [ -f "$log_file" ]; then
        {
            echo "---"
            echo "# Status: Killed by user (gpu-run --kill)"
            echo "# Ended:  $(date -Iseconds)"
        } >> "$log_file"
    fi

    echo -e "${GREEN}Job ${job_name} killed.${NC}"
}

# Clean up completed jobs
clean_jobs() {
    check_env
    echo -e "${YELLOW}Cleaning up completed GPU jobs for ${RELEASE_NAME}...${NC}"
    kubectl delete jobs -n "$GPU_JOB_NAMESPACE" -l "dev-code-server-release=$RELEASE_NAME" \
        --field-selector status.successful=1 2>/dev/null || true
    kubectl delete jobs -n "$GPU_JOB_NAMESPACE" -l "dev-code-server-release=$RELEASE_NAME" \
        --field-selector status.failed=1 2>/dev/null || true
    echo -e "${GREEN}Done${NC}"
}

# Check GPU status and availability
check_status() {
    check_env
    echo -e "${BLUE}╔════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${BLUE}║${NC}                    ${GREEN}GPU Status Check${NC}                        ${BLUE}║${NC}"
    echo -e "${BLUE}╚════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    
    # Check if GPU support is enabled in the template
    local gpu_enabled="unknown"
    if [ -f "/etc/gpu-job/gpu-support-enabled" ]; then
        gpu_enabled=$(cat /etc/gpu-job/gpu-support-enabled)
    fi
    echo -e "${YELLOW}GPU Support in Kaapana:${NC} ${gpu_enabled}"
    
    # Show the GPU job template to verify GPU is requested
    echo ""
    echo -e "${YELLOW}GPU request in job template:${NC}"
    if [ -f "/etc/gpu-job/gpu-job-template.yaml" ]; then
        grep -A1 "limits:" /etc/gpu-job/gpu-job-template.yaml | grep -i gpu && echo -e "  ${GREEN}GPU is requested in job template${NC}" || echo -e "  ${RED}No GPU limit found in job template${NC}"
    else
        echo -e "  ${RED}Job template not found${NC}"
    fi
    echo ""
    
    # Check cluster GPU resources
    echo -e "${YELLOW}Cluster GPU Resources:${NC}"
    if kubectl get nodes &>/dev/null; then
        local gpu_nodes=$(kubectl get nodes -o jsonpath='{range .items[*]}{.metadata.name}{"\t"}{.status.capacity.nvidia\.com/gpu}{"\n"}{end}' 2>/dev/null)
        local found_gpu=0
        while IFS=$'\t' read -r node gpus; do
            if [ -n "$gpus" ] && [ "$gpus" != "<none>" ] && [ "$gpus" != "null" ] && [ "$gpus" != "" ]; then
                echo -e "  Node: ${node} - GPUs: ${GREEN}${gpus}${NC}"
                found_gpu=1
            fi
        done <<< "$gpu_nodes"
        if [ $found_gpu -eq 0 ]; then
            echo -e "  ${RED}No GPU nodes found in cluster${NC}"
            echo -e "  ${YELLOW}Tip: Make sure the NVIDIA device plugin is installed${NC}"
        fi
    else
        echo -e "  ${RED}Cannot access cluster nodes (permission denied)${NC}"
        echo -e "  ${YELLOW}Tip: Redeploy the code-server to get updated RBAC permissions${NC}"
    fi
    echo ""
    
    # Check for pods using GPUs
    echo -e "${YELLOW}Pods currently using GPUs (in all namespaces):${NC}"
    if kubectl get pods --all-namespaces &>/dev/null; then
        local found_gpu_pods=0
        while IFS= read -r line; do
            local ns=$(echo "$line" | awk '{print $1}')
            local pod=$(echo "$line" | awk '{print $2}')
            local gpu_req=$(kubectl get pod -n "$ns" "$pod" -o jsonpath='{.spec.containers[*].resources.limits.nvidia\.com/gpu}' 2>/dev/null)
            if [ -n "$gpu_req" ] && [ "$gpu_req" != "0" ]; then
                local status=$(kubectl get pod -n "$ns" "$pod" -o jsonpath='{.status.phase}' 2>/dev/null)
                echo -e "  ${YELLOW}$ns/$pod${NC} - GPUs: $gpu_req (Status: $status)"
                found_gpu_pods=1
            fi
        done < <(kubectl get pods --all-namespaces --no-headers 2>/dev/null)
        if [ $found_gpu_pods -eq 0 ]; then
            echo -e "  ${GREEN}No pods currently using GPUs${NC}"
        fi
    else
        echo -e "  ${RED}Cannot list pods cluster-wide (permission denied)${NC}"
    fi
    echo ""
    
    # Check GPU jobs for this release
    echo -e "${YELLOW}GPU Jobs for this code-server:${NC}"
    local jobs=$(kubectl get jobs -n "$GPU_JOB_NAMESPACE" -l "dev-code-server-release=$RELEASE_NAME" --no-headers 2>/dev/null)
    if [ -z "$jobs" ]; then
        echo -e "  ${GREEN}No GPU jobs found${NC}"
    else
        kubectl get jobs -n "$GPU_JOB_NAMESPACE" -l "dev-code-server-release=$RELEASE_NAME" 2>/dev/null
        echo ""
        
        # Show details for pending/failed pods
        local problem_pods=$(kubectl get pods -n "$GPU_JOB_NAMESPACE" -l "dev-code-server-release=$RELEASE_NAME" --no-headers 2>/dev/null | grep -v "Running\|Completed")
        if [ -n "$problem_pods" ]; then
            echo -e "${YELLOW}Problem pods (not Running/Completed):${NC}"
            echo "$problem_pods"
            echo ""
            echo -e "${YELLOW}Events for problem pods:${NC}"
            while read -r line; do
                local pod_name=$(echo "$line" | awk '{print $1}')
                echo -e "--- ${pod_name} ---"
                kubectl get events -n "$GPU_JOB_NAMESPACE" --field-selector "involvedObject.name=$pod_name" --sort-by='.lastTimestamp' 2>/dev/null | tail -5
            done <<< "$problem_pods"
        fi
    fi
}

# Main function to run a GPU job
run_gpu_job() {
    check_env
    
    # Parse --name option
    local name_prefix=""
    if [ "$1" = "--name" ]; then
        shift
        name_prefix="$1"
        shift
    fi
    
    local script="$1"
    shift
    local args="$*"
    
    if [ -z "$script" ]; then
        echo -e "${RED}Error: No script specified${NC}"
        echo "Usage: gpu-run <script.py> [args...]"
        exit 1
    fi
    
    # Check if script exists (relative to /kaapana/minio)
    local script_path="/kaapana/minio/$script"
    if [ ! -f "$script_path" ] && [ ! -f "/kaapana/minio/$(pwd | sed 's|/kaapana/minio/||')/$script" ]; then
        # Try relative to current directory
        if [ -f "$(pwd)/$script" ]; then
            script_path="$(pwd)/$script"
            script="${script_path#/kaapana/minio/}"
        else
            echo -e "${YELLOW}Warning: Script '$script' not found locally. It may exist when the job runs.${NC}"
        fi
    fi
    
    # Generate unique job name with date for easy identification
    local datestamp=$(date +%Y%m%d-%H%M%S)
    local random_suffix=$(head /dev/urandom | tr -dc a-z0-9 | head -c 6)
    local job_name=""
    if [ -n "$name_prefix" ]; then
        # Sanitize prefix: lowercase, replace non-alphanumeric with dash, trim dashes
        local sanitized=$(echo "$name_prefix" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9-]/-/g; s/--*/-/g; s/^-//; s/-$//')
        job_name="${sanitized}-${datestamp}-${random_suffix}"
    else
        job_name="gpu-job-${datestamp}-${random_suffix}"
    fi
    
    # Kubernetes names must be <= 63 chars
    job_name="${job_name:0:63}"
    
    # Set up log file
    mkdir -p "$GPU_LOG_DIR"
    local log_file="${GPU_LOG_DIR}/${job_name}.log"
    
    # Determine the command to run
    # Use unbuffered mode for Python (-u) and stdbuf for others
    # to ensure real-time log streaming via kubectl logs --follow
    local command=""
    if [[ "$script" == *.py ]]; then
        command="cd /kaapana/minio && python -u $script $args"
    elif [[ "$script" == *.sh ]]; then
        command="cd /kaapana/minio && bash $script $args"
    elif [[ "$script" == *.r ]] || [[ "$script" == *.R ]]; then
        command="cd /kaapana/minio && stdbuf -oL Rscript $script $args"
    else
        command="cd /kaapana/minio && stdbuf -oL $script $args"
    fi
    
    echo -e "${BLUE}╔════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${BLUE}║${NC}                    ${GREEN}GPU Job Launcher${NC}                        ${BLUE}║${NC}"
    echo -e "${BLUE}╠════════════════════════════════════════════════════════════╣${NC}"
    echo -e "${BLUE}║${NC} Job Name:  ${YELLOW}${job_name}${NC}"
    echo -e "${BLUE}║${NC} Date:      $(date '+%Y-%m-%d %H:%M:%S %Z')"
    echo -e "${BLUE}║${NC} Script:    ${script}"
    echo -e "${BLUE}║${NC} Arguments: ${args:-<none>}"
    echo -e "${BLUE}║${NC} Namespace: ${GPU_JOB_NAMESPACE}"
    echo -e "${BLUE}║${NC} Log file:  ${log_file}"
    echo -e "${BLUE}╚════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    
    # Write header to log file
    {
        echo "# GPU Job: ${job_name}"
        echo "# Date:    $(date '+%Y-%m-%d %H:%M:%S %Z')"
        echo "# Script:  ${script}"
        echo "# Args:    ${args:-<none>}"
        echo "# Started: $(date -Iseconds)"
        echo "# Command: ${command}"
        echo "---"
    } > "$log_file"
    
    # Read the template and substitute values
    local template="/etc/gpu-job/gpu-job-template.yaml"
    if [ ! -f "$template" ]; then
        echo -e "${RED}Error: GPU job template not found at ${template}${NC}"
        exit 1
    fi
    
    # Escape special characters for sed replacement (& and \ need escaping)
    local escaped_command=$(printf '%s\n' "$command" | sed 's/[&/\]/\\&/g')
    
    # Create the job manifest
    local job_manifest=$(cat "$template" | \
        sed "s|GPU_JOB_NAME|${job_name}|g" | \
        sed "s|GPU_COMMAND|${escaped_command}|g")
    
    # Apply the job
    echo -e "${YELLOW}Creating GPU job...${NC}"
    echo "$job_manifest" | kubectl apply -f - 
    
    echo -e "${GREEN}Job created successfully!${NC}"
    echo ""
    
    # Set up Ctrl+C handler to kill the job
    trap '_on_interrupt' INT
    _on_interrupt() {
        echo ""
        echo ""
        echo -e "${YELLOW}Interrupted! Deleting GPU job ${job_name}...${NC}"
        kubectl delete job -n "$GPU_JOB_NAMESPACE" "$job_name" --wait=false 2>/dev/null || true
        echo -e "${RED}Job ${job_name} deleted.${NC}"
        # Append to log file
        {
            echo "---"
            echo "# Status: Interrupted by user (Ctrl+C)"
            echo "# Ended:  $(date -Iseconds)"
        } >> "$log_file" 2>/dev/null
        trap - INT
        exit 130
    }
    
    echo -e "${BLUE}Waiting for pod to start...${NC}"
    
    # Wait for the pod to be created
    local max_wait=300
    local waited=0
    local gpu_wait_msg_shown=0
    local pod_name=""
    while [ $waited -lt $max_wait ]; do
        # Check if the pod exists yet
        pod_name=$(kubectl get pods -n "$GPU_JOB_NAMESPACE" -l "job-name=$job_name" -o jsonpath='{.items[0].metadata.name}' 2>/dev/null)
        if [ -n "$pod_name" ]; then
            local pod_status=$(kubectl get pod -n "$GPU_JOB_NAMESPACE" "$pod_name" -o jsonpath='{.status.phase}' 2>/dev/null)
            
            if [ "$pod_status" = "Running" ] || [ "$pod_status" = "Succeeded" ] || [ "$pod_status" = "Failed" ]; then
                break
            fi
            
            if [ "$pod_status" = "Pending" ]; then
                # Check container status for more detail
                local container_waiting=$(kubectl get pod -n "$GPU_JOB_NAMESPACE" "$pod_name" \
                    -o jsonpath='{.status.containerStatuses[0].state.waiting.reason}' 2>/dev/null)
                local schedule_reason=$(kubectl get pod -n "$GPU_JOB_NAMESPACE" "$pod_name" \
                    -o jsonpath='{.status.conditions[?(@.type=="PodScheduled")].reason}' 2>/dev/null)
                local schedule_msg=$(kubectl get pod -n "$GPU_JOB_NAMESPACE" "$pod_name" \
                    -o jsonpath='{.status.conditions[?(@.type=="PodScheduled")].message}' 2>/dev/null)
                
                if [ "$schedule_reason" = "Unschedulable" ] && [ $gpu_wait_msg_shown -eq 0 ]; then
                    echo -e "${YELLOW}Pod is unschedulable: ${schedule_msg}${NC}"
                    echo -e "${YELLOW}Waiting for GPU to become available... (this may take a while)${NC}"
                    echo -e "${YELLOW}Run 'gpu-run --status' in another terminal for diagnostics${NC}"
                    gpu_wait_msg_shown=1
                elif [ -n "$container_waiting" ] && [ "$container_waiting" != "ContainerCreating" ] && [ $gpu_wait_msg_shown -eq 0 ]; then
                    echo -e "${YELLOW}Container waiting: ${container_waiting}${NC}"
                    gpu_wait_msg_shown=1
                fi
            fi
        fi
        
        # Show a dot every 10 seconds to indicate progress
        if [ $((waited % 10)) -eq 0 ] && [ $waited -gt 0 ]; then
            echo -n "."
        fi
        
        sleep 2
        waited=$((waited + 2))
    done
    
    # Print newline if we showed progress dots
    if [ $waited -gt 10 ]; then
        echo ""
    fi
    
    if [ $waited -ge $max_wait ]; then
        echo -e "${YELLOW}Pod is taking longer than expected to start. You can check status with:${NC}"
        echo "  gpu-run --list"
        echo "  gpu-run --logs $job_name"
        exit 0
    fi
    
    echo -e "${GREEN}Pod started! Streaming logs...${NC}"
    echo -e "${BLUE}════════════════════════════════════════════════════════════${NC}"
    echo ""
    
    # Stream logs, retrying if the container isn't ready yet.
    # kubectl logs --follow can exit silently if the container finishes very
    # quickly or if called during the transition from Pending to Running.
    # We retry a few times and also handle the case where the job already
    # completed (Succeeded/Failed) by fetching logs without --follow.
    local logs_streamed=false
    for attempt in 1 2 3; do
        if [ -n "$pod_name" ]; then
            local current_phase=$(kubectl get pod -n "$GPU_JOB_NAMESPACE" "$pod_name" -o jsonpath='{.status.phase}' 2>/dev/null)
            if [ "$current_phase" = "Succeeded" ] || [ "$current_phase" = "Failed" ]; then
                # Pod already finished — get full logs (no --follow)
                kubectl logs -n "$GPU_JOB_NAMESPACE" "$pod_name" 2>/dev/null | tee -a "$log_file" || true
                logs_streamed=true
                break
            fi
            # Pod still running — stream with --follow
            kubectl logs -n "$GPU_JOB_NAMESPACE" "$pod_name" --follow 2>/dev/null | tee -a "$log_file" || true
            # Check if the pod is done now
            current_phase=$(kubectl get pod -n "$GPU_JOB_NAMESPACE" "$pod_name" -o jsonpath='{.status.phase}' 2>/dev/null)
            if [ "$current_phase" = "Succeeded" ] || [ "$current_phase" = "Failed" ] || [ "$current_phase" = "" ]; then
                logs_streamed=true
                break
            fi
        else
            kubectl logs -n "$GPU_JOB_NAMESPACE" -l "job-name=$job_name" --follow 2>/dev/null | tee -a "$log_file" || true
            logs_streamed=true
            break
        fi
        # Brief pause before retry
        sleep 2
    done
    
    # If streaming failed, dump whatever logs exist
    if [ "$logs_streamed" != "true" ] && [ -n "$pod_name" ]; then
        echo -e "${YELLOW}Fetching final logs...${NC}"
        kubectl logs -n "$GPU_JOB_NAMESPACE" "$pod_name" 2>/dev/null | tee -a "$log_file" || true
    fi
    
    echo ""
    echo -e "${BLUE}════════════════════════════════════════════════════════════${NC}"
    
    # Disable the Ctrl+C job-kill handler now that streaming is done
    trap - INT
    
    # Wait a moment for job status to update
    sleep 1
    
    # Check job status - try multiple times as it may take a moment to update
    local job_status=""
    for i in 1 2 3; do
        job_status=$(kubectl get job -n "$GPU_JOB_NAMESPACE" "$job_name" -o jsonpath='{.status.conditions[0].type}' 2>/dev/null)
        if [ -n "$job_status" ]; then
            break
        fi
        sleep 1
    done
    
    # Also check succeeded/failed counts as fallback
    if [ -z "$job_status" ]; then
        local succeeded=$(kubectl get job -n "$GPU_JOB_NAMESPACE" "$job_name" -o jsonpath='{.status.succeeded}' 2>/dev/null)
        local failed=$(kubectl get job -n "$GPU_JOB_NAMESPACE" "$job_name" -o jsonpath='{.status.failed}' 2>/dev/null)
        if [ "$succeeded" = "1" ]; then
            job_status="Complete"
        elif [ -n "$failed" ] && [ "$failed" != "0" ]; then
            job_status="Failed"
        fi
    fi
    
    if [ "$job_status" = "Complete" ]; then
        echo -e "${GREEN}✓ Job completed successfully${NC}"
        echo "---" >> "$log_file"
        echo "# Status: Completed successfully" >> "$log_file"
        echo "# Ended:  $(date -Iseconds)" >> "$log_file"
    elif [ "$job_status" = "Failed" ]; then
        echo -e "${RED}✗ Job failed${NC}"
        echo "---" >> "$log_file"
        echo "# Status: Failed" >> "$log_file"
        echo "# Ended:  $(date -Iseconds)" >> "$log_file"
        exit 1
    else
        echo -e "${YELLOW}Job status: ${job_status:-Unknown}${NC}"
        echo "---" >> "$log_file"
        echo "# Status: ${job_status:-Unknown}" >> "$log_file"
        echo "# Ended:  $(date -Iseconds)" >> "$log_file"
    fi
    
    echo ""
    echo -e "To view logs again: ${YELLOW}gpu-run --logs $job_name${NC}"
    echo -e "To delete the job:  ${YELLOW}gpu-run --delete $job_name${NC}"
    echo -e "Log file:           ${YELLOW}$log_file${NC}"
}

# Parse arguments
case "${1:-}" in
    --help|-h)
        show_help
        exit 0
        ;;
    --list|-l)
        list_jobs
        exit 0
        ;;
    --logs)
        show_logs "$2"
        exit 0
        ;;
    --delete)
        delete_job "$2"
        exit 0
        ;;
    --kill|-k)
        kill_job "$2"
        exit 0
        ;;
    --clean)
        clean_jobs
        exit 0
        ;;
    --status|-s)
        check_status
        exit 0
        ;;
    "")
        echo -e "${RED}Error: No script specified${NC}"
        echo "Usage: gpu-run <script.py> [args...]"
        echo "       gpu-run --name <prefix> <script.py> [args...]"
        echo "       gpu-run --help for more information"
        exit 1
        ;;
    --name)
        # --name as first arg: pass through to run_gpu_job
        run_gpu_job "$@"
        ;;
    *)
        run_gpu_job "$@"
        ;;
esac
