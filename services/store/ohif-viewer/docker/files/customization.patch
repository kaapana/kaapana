+      const segmentationId = segDisplaySet.displaySetInstanceUID;
+      const segmentIndex = cstUtils.segmentation.getSegmentIndexAtWorldPoint(
+        segmentationId,
+        worldPos,
+        { viewport }
+      );
+
+      // 0 / undefined -> background / no segment at this point.
+      if (!segmentIndex) {
+        return;
+      }
+
+      const segmentation = segmentationService.getSegmentation(segmentationId);
+      const segment = segmentation?.segments?.[segmentIndex];
+
+      window.parent.postMessage(
+        {
+          type: 'ohif-segment-click',
+          segmentationId,
+          segmentIndex,
+          label: segment?.label ?? null,
+        },
+        window.location.origin
+      );
+    };
+
+    element.addEventListener('click', handleSegmentClick);
+    return () => {
+      element.removeEventListener('click', handleSegmentClick);
+    };
