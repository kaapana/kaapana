{
  "name": "@kaapana/extension-nninteractive",
  "version": "3.10.4",
  "description": "Kaapana nnInteractive OHIF extension",
  "author": "Kaapana",
  "license": "MIT",
  "repository": "Kaapana",
  "main": "dist/ohif-extension-nninteractive.umd.js",
  "module": "src/index.ts",
  "engines": {
    "node": ">=18",
    "npm": ">=6",
    "yarn": ">=1.20.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "ohif-extension"
  ],
  "scripts": {
    "clean": "shx rm -rf dist",
    "clean:deep": "yarn run clean && shx rm -rf node_modules",
    "dev": "cross-env NODE_ENV=development webpack --config .webpack/webpack.dev.js --watch --output-pathinfo",
    "build": "cross-env NODE_ENV=production webpack --config .webpack/webpack.prod.js",
    "build:package-1": "yarn run build",
    "start": "yarn run dev"
  },
  "peerDependencies": {
    "@cornerstonejs/core": "^3.33.5",
    "@cornerstonejs/tools": "^3.33.5",
    "axios": "^1.16.0",
    "classnames": "^2.3.2",
    "@ohif/core": "3.10.4",
    "@ohif/extension-cornerstone": "3.10.4",
    "@ohif/extension-cornerstone-dicom-seg": "3.10.4",
    "@ohif/extension-default": "3.10.4",
    "@ohif/i18n": "3.10.4",
    "@ohif/ui-next": "3.10.4",
    "dcmjs": "0.42.0",
    "lucide-react": "^0.394.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^12.2.2",
    "webpack": "5.104.1",
    "webpack-merge": "^5.7.3"
  },
  "dependencies": {
    "@babel/runtime": "^7.20.13"
  }
}
