server {
	listen 80 default_server;
	# listen [::]:80 default_server ipv6only=on;

	#_SSL_PORT_#listen 443 ssl default_server;
	#_SSL_PORT_#listen [::]:443 ssl default_server ipv6only=on;
	#_SSL_PORT_#ssl_certificate /etc/nginx/ssl/nginx.crt;
	#_SSL_PORT_#ssl_certificate_key /etc/nginx/ssl/nginx.key;

	#_HTTP_PASSWORD_#auth_basic "Private Property";
	#_HTTP_PASSWORD_#auth_basic_user_file /etc/nginx/.htpasswd;

	# Selkies prebuilt web client (SPA).
	root /usr/share/selkies/selkies-dashboard/;
	index index.html;

	# Selkies data websocket (pixelflux stripes). The client connects to "<base>websockets";
	# match that suffix (singular or plural) under any ingress prefix. Selkies accepts the
	# upgrade on any path, so no rewrite is needed. This regex location is evaluated before
	# the prefix locations.
	location ~ /websockets?$ {
		proxy_connect_timeout       7d;
		proxy_send_timeout          7d;
		proxy_read_timeout          7d;
		proxy_buffering             off;

		proxy_http_version 1.1;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection "upgrade";
		proxy_set_header Host $host;
		proxy_pass http://127.0.0.1:8082; # selkies
	}

	#_RELATIVE_URL_ROOT_location /_RELATIVE_URL_ROOT_/ {
	#_RELATIVE_URL_ROOT_	rewrite /_RELATIVE_URL_ROOT_/(.*) /$1 break;
	#_RELATIVE_URL_ROOT_	root /usr/share/selkies/selkies-dashboard/;
	#_RELATIVE_URL_ROOT_	try_files $uri $uri/ /index.html;
	#_RELATIVE_URL_ROOT_}

	location / {
		try_files $uri $uri/ /index.html;
	}
}
